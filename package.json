    "test:stripe-database:postgrest": "node stripe-billing-database.postgrest.test.mjs",
    "test:stripe-lifecycle": "node stripe-billing-lifecycle.contract.test.mjs",
    "test:stripe-configuration": "node stripe-billing-configuration.contract.test.mjs",
    "test:stripe-gateway": "node stripe-billing-gateway.contract.test.mjs",
    "test:stripe-repository": "node stripe-billing-repository.contract.test.mjs",
    "test:stripe-application": "node stripe-billing-application.contract.test.mjs",
    "test:stripe-application:postgrest": "node stripe-billing-application.postgrest.test.mjs",
