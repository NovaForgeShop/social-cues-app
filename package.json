    "test:vizard-connection-management:postgrest": "node vizard-connection-management.postgrest.test.mjs",
    "test:heygen-integration": "node --test heygen-integration.contract.test.mjs",
    "test:heygen-oauth": "node --test heygen-oauth-client.contract.test.mjs",
    "test:heygen-mcp": "node --test heygen-mcp-client.contract.test.mjs",
    "test:heygen-workflow": "node --test heygen-media-workflow.contract.test.mjs",
    "test:heygen-application": "node --test heygen-application.contract.test.mjs",
    "test:workspace-authorization": "node workspace-management-authorization.contract.test.mjs",
    "test:e2e": "playwright test",
    "test:tester-loop": "node scripts/run-tester-loop.mjs",
    "test:local-audit": "node scripts/run-tester-loop.mjs tests/social-cues-button-audit.spec.ts tests/social-cues-tester-loop.spec.ts",
    "test:mobile": "set E2E_PROJECTS=mobile-chrome,mobile-safari&& node scripts/run-tester-loop.mjs tests/social-cues-mobile-shell.spec.ts",
    "test:media-journey": "set E2E_PROJECTS=chromium,mobile-chrome,mobile-safari&& node scripts/run-tester-loop.mjs tests/social-cues-media-publish-journey.spec.ts",
    "test:production-canary": "node scripts/production-canary.mjs",
    "test:render-contract": "node scripts/render-worker-contract-check.mjs",
    "squarespace:canary": "node scripts/squarespace-canary.mjs",
    "vizard:canary": "node scripts/vizard-canary.mjs",
    "smtp:check": "node scripts/configure-supabase-smtp.mjs",
    "smtp:apply": "node scripts/configure-supabase-smtp.mjs --apply",
    "vercel:env:audit": "node scripts/sync-vercel-env.mjs --dry-run",
    "vercel:env:sync": "node scripts/sync-vercel-env.mjs",
    "render:coming-soon": "remotion render remotion/index.ts SocialCuesComingSoon outputs/social-cues-coming-soon-remotion.mp4 --overwrite",
    "render:still": "remotion still remotion/index.ts SocialCuesComingSoon outputs/social-cues-coming-soon-remotion.png --frame=75 --overwrite",
    "video:dissect": "node scripts/video-dissection.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/node": "^26.0.1"
  },
  "dependencies": {
    "@remotion/cli": "4.0.499",
    "@remotion/renderer": "4.0.499",
    "@sentry/node": "^10.66.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "remotion": "4.0.499",
    "web-push": "3.6.7"
  }
