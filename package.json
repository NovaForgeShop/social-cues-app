{
  "name": "social-cues-testable-app",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node server.mjs",
    "test": "node test.mjs",
    "alpha:smoke": "node scripts/alpha-public-smoke.mjs",
    "test:alpha-public-smoke": "node scripts/alpha-public-smoke.contract.test.mjs",
    "test:release-readiness": "node release-readiness.contract.test.mjs",
    "test:alpha-discount": "node --test alpha-discount.contract.test.mjs",
    "test:pricing": "node pricing-packaging.contract.test.mjs",
    "test:pricing-presentation": "node pricing-presentation.contract.test.mjs",
    "test:move-ledger": "node move-ledger.contract.test.mjs",
    "test:move-ledger-repository": "node move-ledger-repository.contract.test.mjs",
    "test:move-ledger-application": "node move-ledger-application.contract.test.mjs",
    "test:stripe-database": "node stripe-billing-database.contract.test.mjs",
